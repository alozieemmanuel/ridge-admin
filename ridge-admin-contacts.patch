diff --git a/src/lib/contactSave.ts b/src/lib/contactSave.ts
new file mode 100644
index 0000000..37bf315
--- /dev/null
+++ b/src/lib/contactSave.ts
@@ -0,0 +1,122 @@
+import { prisma } from "@/lib/prisma";
+import type { ImportedPerson } from "@/lib/csvImport";
+
+const CHUNK = 500;
+
+export interface SaveResult {
+  added: number;
+  updated: number;
+  /** Already on the list and left alone (onDuplicate = "skip"). */
+  skipped: number;
+  /** Already on the list, "update" was on, and nothing in the file was new. */
+  unchanged: number;
+}
+
+function chunks<T>(items: T[]): T[][] {
+  const out: T[][] = [];
+  for (let i = 0; i < items.length; i += CHUNK) out.push(items.slice(i, i + CHUNK));
+  return out;
+}
+
+/** Compares two "extra" objects without caring about key order (the database may return the keys in another order). */
+function sameExtra(a: unknown, b: Record<string, string>): boolean {
+  const left = (a && typeof a === "object" ? (a as Record<string, unknown>) : {}) as Record<string, unknown>;
+  const lk = Object.keys(left).sort();
+  const rk = Object.keys(b).sort();
+  return lk.length === rk.length && lk.every((k, i) => k === rk[i] && String(left[k]) === b[k]);
+}
+
+/**
+ * Saves people read from a CSV file or a live sheet. Nobody is emailed.
+ *
+ *   New emails are added. Call feedback that came with a person becomes the first entry in their follow-up log.
+ *   Emails already on the list are left alone ("skip") or filled in from the file ("update"). An update never blanks a
+ *   field, never touches a reservation, and never adds a follow-up entry that is already in the log, so running it
+ *   again and again (as the live sheet does) is safe.
+ *
+ *   overwriteStatus: true  the file's follow-up status always replaces the current one (one-off CSV import).
+ *                    false the file's status is only used when it brings a new call note, or the guest has not been contacted yet.
+ *                           This keeps what the team set in the dashboard from being undone by an older row in the sheet.
+ */
+export async function saveImportedPeople(
+  people: ImportedPerson[],
+  onDuplicate: "skip" | "update",
+  opts: { author?: string; overwriteStatus?: boolean } = {}
+): Promise<SaveResult> {
+  const author = opts.author ?? "Imported from CSV";
+  const overwriteStatus = opts.overwriteStatus ?? true;
+
+  const existing: { id: string; email: string; fullName: string; phone: string; followUpStatus: string; extra: unknown }[] = [];
+  for (const part of chunks(people.map((p) => p.email))) {
+    existing.push(
+      ...(await prisma.registration.findMany({
+        where: { email: { in: part } },
+        select: { id: true, email: true, fullName: true, phone: true, followUpStatus: true, extra: true },
+      }))
+    );
+  }
+  const byEmail = new Map(existing.map((e) => [e.email, e]));
+  const fresh = people.filter((p) => !byEmail.has(p.email));
+  const dups = people.filter((p) => byEmail.has(p.email));
+
+  let added = 0;
+  for (const part of chunks(fresh)) {
+    const res = await prisma.registration.createMany({
+      skipDuplicates: true,
+      data: part.map((p) => ({
+        fullName: p.fullName,
+        email: p.email,
+        phone: p.phone,
+        followUpStatus: p.followUpStatus ?? "NOT_CONTACTED",
+        extra: Object.keys(p.extra).length ? p.extra : undefined,
+      })),
+    });
+    added += res.count;
+  }
+
+  // Feedback that came in with the file becomes the first entry in each new guest's follow-up log.
+  const withFeedback = fresh.filter((p) => p.callFeedback);
+  for (const part of chunks(withFeedback)) {
+    const rows = await prisma.registration.findMany({ where: { email: { in: part.map((p) => p.email) } }, select: { id: true, email: true } });
+    const idByEmail = new Map(rows.map((r: { id: string; email: string }) => [r.email, r.id]));
+    await prisma.followUpNote.createMany({
+      data: part.flatMap((p) => {
+        const registrationId = idByEmail.get(p.email);
+        return registrationId ? [{ registrationId, body: p.callFeedback!, status: p.followUpStatus, authorName: author }] : [];
+      }),
+    });
+  }
+
+  let updated = 0;
+  let unchanged = 0;
+  if (onDuplicate === "update" && dups.length) {
+    // The notes already in each guest's log, so the same line is never added twice.
+    const known = new Set<string>();
+    for (const part of chunks(dups.map((p) => byEmail.get(p.email)!.id))) {
+      const notes = await prisma.followUpNote.findMany({ where: { registrationId: { in: part } }, select: { registrationId: true, body: true } });
+      for (const n of notes) known.add(`${n.registrationId}\n${n.body}`);
+    }
+
+    for (const p of dups) {
+      const current = byEmail.get(p.email)!;
+      const data: Record<string, unknown> = {};
+      if (p.fullName && p.fullName !== current.fullName) data.fullName = p.fullName;
+      if (p.phone && p.phone !== current.phone) data.phone = p.phone;
+      if (Object.keys(p.extra).length && !sameExtra(current.extra, p.extra)) data.extra = p.extra;
+
+      const newNote = Boolean(p.callFeedback) && !known.has(`${current.id}\n${p.callFeedback}`);
+      if (p.followUpStatus && p.followUpStatus !== current.followUpStatus && (overwriteStatus || newNote || current.followUpStatus === "NOT_CONTACTED")) {
+        data.followUpStatus = p.followUpStatus;
+      }
+
+      if (Object.keys(data).length) await prisma.registration.update({ where: { id: current.id }, data });
+      if (newNote) {
+        await prisma.followUpNote.create({ data: { registrationId: current.id, body: p.callFeedback!, status: p.followUpStatus, authorName: author } });
+      }
+      if (Object.keys(data).length || newNote) updated++;
+      else unchanged++;
+    }
+  }
+
+  return { added, updated, skipped: onDuplicate === "skip" ? dups.length : 0, unchanged };
+}
diff --git a/src/lib/contactSheet.ts b/src/lib/contactSheet.ts
new file mode 100644
index 0000000..3cfa4a4
--- /dev/null
+++ b/src/lib/contactSheet.ts
@@ -0,0 +1,177 @@
+import { prisma } from "@/lib/prisma";
+import { buildPeople, parseCsvText, suggestMapping, type RowProblem } from "@/lib/csvImport";
+import { saveImportedPeople } from "@/lib/contactSave";
+
+/**
+ * The live sheet: one Google Sheet link kept in the Settings table. "Sync" reads the sheet and adds or updates
+ * contacts by email, exactly like a CSV import (nobody is emailed). The sheet has to be shared as
+ * "Anyone with the link can view", or published to the web as CSV, so no Google login is needed here.
+ */
+
+export const SHEET_URL_KEY = "contacts_sheet_url";
+export const SHEET_LAST_SYNC_KEY = "contacts_sheet_last_sync";
+/** Settings keys that belong to the live sheet. They are kept out of the Event details form and survive "clear everything". */
+export const SHEET_KEYS = [SHEET_URL_KEY, SHEET_LAST_SYNC_KEY];
+
+export interface LastSync {
+  at: string;
+  ok: boolean;
+  error?: string;
+  rows?: number;
+  added?: number;
+  updated?: number;
+  unchanged?: number;
+  problemCount?: number;
+}
+
+export interface SyncResult extends LastSync {
+  problems: RowProblem[];
+}
+
+/** Turns any Google Sheets link into the address that returns the sheet as CSV. Returns null when it isn't a usable link. */
+export function toCsvUrl(input: string): string | null {
+  const raw = input.trim();
+  if (!raw) return null;
+  let url: URL;
+  try {
+    url = new URL(raw);
+  } catch {
+    return null;
+  }
+  if (url.protocol !== "https:") return null;
+
+  const isGoogle = url.hostname === "docs.google.com";
+  if (!isGoogle) return url.toString(); // any other direct link to a CSV file
+
+  // "Publish to the web" links (/d/e/...): ask for CSV.
+  if (/^\/spreadsheets\/d\/e\//.test(url.pathname)) {
+    const path = url.pathname.replace(/\/(pubhtml|pub)?$/, "") + "/pub";
+    const out = new URL(`https://docs.google.com${path}`);
+    out.searchParams.set("output", "csv");
+    const gid = url.searchParams.get("gid");
+    if (gid) out.searchParams.set("gid", gid);
+    return out.toString();
+  }
+
+  const match = url.pathname.match(/^\/spreadsheets\/d\/([a-zA-Z0-9_-]+)/);
+  if (!match) return null;
+  const gid = url.searchParams.get("gid") ?? new URLSearchParams(url.hash.replace(/^#/, "")).get("gid");
+  const out = new URL(`https://docs.google.com/spreadsheets/d/${match[1]}/export`);
+  out.searchParams.set("format", "csv");
+  if (gid) out.searchParams.set("gid", gid);
+  return out.toString();
+}
+
+const NOT_SHARED = "Google did not let this app read the sheet. In the sheet choose Share, then General access, then \"Anyone with the link\" as Viewer, and try again.";
+
+async function fetchCsv(csvUrl: string): Promise<string> {
+  let res: Response;
+  try {
+    res = await fetch(csvUrl, { redirect: "follow", cache: "no-store", signal: AbortSignal.timeout(30_000) });
+  } catch {
+    throw new Error("Could not reach the sheet. Check the link and try again.");
+  }
+  if (res.status === 401 || res.status === 403) throw new Error(NOT_SHARED);
+  if (res.status === 404) throw new Error("That sheet was not found. Check the link.");
+  if (!res.ok) throw new Error(`The sheet could not be read (error ${res.status}).`);
+  const type = res.headers.get("content-type") ?? "";
+  const text = await res.text();
+  // A sign-in page comes back as HTML with a 200.
+  if (type.includes("text/html") || /^\s*<(!doctype|html)/i.test(text)) throw new Error(NOT_SHARED);
+  return text;
+}
+
+async function readSetting(key: string): Promise<string | null> {
+  return (await prisma.setting.findUnique({ where: { key } }))?.value ?? null;
+}
+
+async function writeSetting(key: string, value: string): Promise<void> {
+  await prisma.setting.upsert({ where: { key }, update: { value }, create: { key, value } });
+}
+
+export async function getSheetState(): Promise<{ url: string; lastSync: LastSync | null }> {
+  const [url, last] = await Promise.all([readSetting(SHEET_URL_KEY), readSetting(SHEET_LAST_SYNC_KEY)]);
+  let lastSync: LastSync | null = null;
+  if (last) {
+    try {
+      lastSync = JSON.parse(last) as LastSync;
+    } catch {
+      lastSync = null;
+    }
+  }
+  return { url: url ?? "", lastSync };
+}
+
+/** Saves (or, when empty, removes) the link. Returns an error message when the link isn't usable. */
+export async function saveSheetUrl(input: string): Promise<{ ok: true } | { ok: false; error: string }> {
+  const trimmed = input.trim();
+  if (!trimmed) {
+    await prisma.setting.deleteMany({ where: { key: { in: SHEET_KEYS } } });
+    return { ok: true };
+  }
+  if (!toCsvUrl(trimmed)) return { ok: false, error: "That is not a Google Sheets link. Paste the address from the sheet's browser tab." };
+  await writeSetting(SHEET_URL_KEY, trimmed);
+  return { ok: true };
+}
+
+/**
+ * Reads the saved sheet and adds or updates contacts by email.
+ *   replace: delete every contact first (their follow-up logs, email history and tickets go with them), then load the sheet.
+ *            The sheet is read and checked BEFORE anything is deleted, so a bad link or a broken sheet deletes nothing.
+ *   minGapMs: skip the work when the last sync was this recent (used by the automatic sync).
+ */
+export async function syncContactSheet(opts: { replace?: boolean; minGapMs?: number } = {}): Promise<SyncResult | { skipped: true }> {
+  const { url, lastSync } = await getSheetState();
+  if (!url) throw new Error("Save the sheet link first.");
+
+  if (opts.minGapMs && lastSync?.ok && Date.now() - new Date(lastSync.at).getTime() < opts.minGapMs) return { skipped: true };
+
+  const fail = async (error: string): Promise<never> => {
+    await writeSetting(SHEET_LAST_SYNC_KEY, JSON.stringify({ at: new Date().toISOString(), ok: false, error } satisfies LastSync));
+    throw new Error(error);
+  };
+
+  const csvUrl = toCsvUrl(url);
+  if (!csvUrl) return fail("The saved link is not a Google Sheets link.");
+
+  let text: string;
+  try {
+    text = await fetchCsv(csvUrl);
+  } catch (err) {
+    return fail(err instanceof Error ? err.message : "The sheet could not be read.");
+  }
+
+  let parsed;
+  try {
+    parsed = parseCsvText(text);
+  } catch (err) {
+    return fail(err instanceof Error ? err.message : "The sheet could not be read.");
+  }
+
+  const mapping = suggestMapping(parsed.headers);
+  const fields = new Set(Object.values(mapping));
+  if (!fields.has("email") || !(fields.has("fullName") || fields.has("firstName"))) {
+    return fail("The sheet needs a column for the email address and a column for the name in its first row.");
+  }
+
+  const { people, problems } = buildPeople(parsed, mapping);
+  if (opts.replace && people.length === 0) return fail("The sheet has no usable rows, so nothing was deleted.");
+
+  if (opts.replace) await prisma.registration.deleteMany({});
+
+  const saved = await saveImportedPeople(people, "update", { author: "Imported from sheet", overwriteStatus: false });
+  const result: SyncResult = {
+    at: new Date().toISOString(),
+    ok: true,
+    rows: parsed.rows.length,
+    added: saved.added,
+    updated: saved.updated,
+    unchanged: saved.unchanged,
+    problemCount: problems.length,
+    problems: problems.slice(0, 50),
+  };
+  const { problems: _omit, ...stored } = result;
+  void _omit;
+  await writeSetting(SHEET_LAST_SYNC_KEY, JSON.stringify(stored satisfies LastSync));
+  return result;
+}
