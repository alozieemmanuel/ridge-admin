+async function findEventBySlug(slug: string) {
+  const hit = eventMemo.get(slug);
+  if (hit && Date.now() - hit.at < EVENT_TTL_MS) return hit.row;
+  const row = await readEvent(slug);
+  if (row) eventMemo.set(slug, { at: Date.now(), row });
+  return row;
+}
