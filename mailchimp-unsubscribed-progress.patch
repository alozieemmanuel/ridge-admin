+    setLoading(true);
+    setError("");
+    try {
+      const res = await fetch("/api/admin/campaigns/mailchimp/unsubscribed", { cache: "no-store" });
+      const data = await res.json().catch(() => ({}));
+      if (!res.ok) {
+        setError(data.error || "Could not read the list from Mailchimp.");
