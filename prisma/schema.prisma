// RIDGE Admin — Database Schema
// Postgres + Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RegType {
  EARLY_BIRD
  LATE
}

enum EmailSource {
  REGISTRATION
  BROCHURE
  CAMPAIGN
}

enum EmailEventType {
  SENT
  DELIVERED
  OPENED
  BOUNCED
  COMPLAINED
  FAILED
}

enum EmailProvider {
  GMAIL // transactional mail: confirmations, reminders, seat invites, internal alerts
  RESEND // campaigns (bulk sends)
}

enum ProofStatus {
  PENDING // uploaded, waiting for an admin
  APPROVED // an admin confirmed the payment it shows
  REJECTED
}

enum EmailAudience {
  ATTENDEE // the registration/brochure confirmation email
  INTERNAL // the internal team notification
}

enum AdminRole {
  OWNER
  ADMIN
}

enum SeatStatus {
  OPEN
  RESERVED
  TAKEN
  BLOCKED
}

enum PaymentStatus {
  NOT_PAID
  PARTIAL
  PAID
}

model Registration {
  id           String  @id @default(cuid())
  fullName     String
  email        String  @unique
  phone        String
  country      String
  organization String?
  notes        String?
  regType      RegType @default(EARLY_BIRD)

  paymentStatus    PaymentStatus @default(NOT_PAID)
  paymentNote      String? // free-text admin note, e.g. "$1000 of $2000 received 9/20"
  amountPaid       Float         @default(0) // total confirmed amount received, in the programme currency;
  // compared against the expected fee to derive paymentStatus
  paymentUpdatedAt DateTime? // last time an admin confirmed a payment amount
  payLaterDate       DateTime? // date the participant asked to be reminded to pay
  payLaterReminderAt DateTime? // when the scheduled reminder was actually sent
  seatInviteSentAt DateTime? // last time the "pick your seat" email was sent
  checkedInAt      DateTime? // when the attendee was marked as arrived on Day 7 (attendance)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emailEvents   EmailEvent[]
  seat          Seat?
  paymentProofs PaymentProof[]

  @@index([createdAt])
}

model BrochureRequest {
  id       String @id @default(cuid())
  fullName String
  email    String

  createdAt DateTime @default(now())

  emailEvents EmailEvent[]

  @@index([email])
  @@index([createdAt])
}

// One row per lifecycle event per email sent (sent/delivered/opened/bounced/...),
// so the admin dashboard can show live counts with a simple GROUP BY.
model EmailEvent {
  id                String           @id @default(cuid())
  source            EmailSource
  registrationId    String?
  registration      Registration?    @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  brochureRequestId String?
  brochureRequest   BrochureRequest? @relation(fields: [brochureRequestId], references: [id], onDelete: Cascade)
  campaignId        String?
  campaign          Campaign?        @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  type              EmailEventType
  audience          EmailAudience  @default(ATTENDEE)
  kind              String? // "confirmation" | "seat_invite" | "payment_reminder" | "payment_confirmation" | "brochure" | "campaign" | "internal"; null on older rows
  providerMessageId String? // Resend's email id, used to correlate webhook events
  errorMessage      String? // why a send FAILED (provider's message), shown on hover in the dashboard
  occurredAt        DateTime       @default(now())

  provider EmailProvider? // which service sent it (null on rows from before this column = Resend)
  subject  String? // the subject as sent

  @@index([registrationId])
  @@index([brochureRequestId])
  @@index([campaignId])
  @@index([providerMessageId])
}

// Append-only record of what each admin did. No foreign key to Admin on
// purpose, so the trail survives an admin being removed.
model AuditLog {
  id          String   @id @default(cuid())
  adminId     String?
  adminName   String
  adminEmail  String?
  action      String // e.g. "auth.login", "registration.payment_update"
  entityType  String? // "registration" | "brochure_request" | "admin" | ...
  entityId    String?
  entityLabel String? // human-readable, e.g. the participant's name
  details     Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([adminId])
  @@index([action])
}

// Editable copy for the attendee-facing emails: registration_confirmation,
// brochure_confirmation, seat_selection_invite, payment_reminder.
// {{first_name}}, {{full_name}}, {{email}} plus the Setting keys below (as
// {{setting_key}}) are available as merge variables in subject/body/replyTo.
// (The internal_* rows from older seeds are unused — internal team alerts are
// now built into src/lib/notifications.ts and are not editable.)
model EmailTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  // one of: registration_confirmation, brochure_confirmation,
  //         seat_selection_invite, payment_reminder
  subject   String
  body      String   @db.Text
  replyTo   String?
  updatedAt DateTime @updatedAt
}

// Business-config values previously hardcoded in code.gs (programme name,
// dates, fee, bank details, WhatsApp number, brochure URL, notification inbox).
// Edited from /admin/settings; referenced by templates as {{key}}.
model Setting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

enum CampaignAudience {
  ALL
  EARLY_BIRD
  LATE
  NOT_PAID
  PARTIAL
  PAID
  CHECKED_IN
  NOT_CHECKED_IN
}

// One row per one-off broadcast sent from /admin/campaigns (the replacement
// for the old per-registration "Emails & WhatsApp" template editor for
// anything that isn't a fixed lifecycle email). Recipients are resolved at
// send time from `audience`; each send also gets its own EmailEvent rows
// (source: CAMPAIGN) so delivery/open tracking works the same as other mail.
model Campaign {
  id             String           @id @default(cuid())
  subject        String
  body           String           @db.Text
  audience       CampaignAudience
  recipientCount Int              @default(0)
  sentCount      Int              @default(0)
  failedCount    Int              @default(0)
  sentAt         DateTime         @default(now())
  sentByName     String?

  emailEvents EmailEvent[]

  @@index([sentAt])
}

model Admin {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(ADMIN)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
  archivedAt   DateTime? // set = archived: can't sign in, hidden from the default list
}

// The Day 7 venue floor plan: round tables labeled A, B, C... AA, AB...
// (spreadsheet-style once past Z), each with numbered seats (A1..A10).
model EventTable {
  id    String @id @default(cuid())
  label String @unique // "A", "B", ... "AA"
  order Int    @unique // display order, 0-based — independent of label so
  // tables can be reordered later without relabeling

  seats Seat[]
}

model Seat {
  id         String     @id @default(cuid())
  tableId    String
  table      EventTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  seatNumber Int // 1..10 within the table
  label      String     @unique // "A2" — table label + seat number, shown to guests and admins

  status SeatStatus @default(OPEN)

  registrationId String?       @unique
  registration   Registration? @relation(fields: [registrationId], references: [id])

  holdExpiresAt DateTime? // for a future payment-pending hold window
  updatedAt     DateTime  @updatedAt

  @@unique([tableId, seatNumber])
  @@index([status])
}

// Proof-of-payment files uploaded by participants from the public payment
// screen. Stored in the database (small images/PDFs, max 4 MB) so no separate
// file storage service is needed.
model PaymentProof {
  id             String       @id @default(cuid())
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  currency       String // USD | CAD | NGN | USD_NG
  method         String? // e.g. "bank_transfer" | "interac"
  fileName       String
  mimeType       String
  size           Int
  amountClaimed  Float? // what the participant said they paid (in `currency`)
  expectedAmount Float? // the fee they were shown in that currency, so admins can tell full from part
  status         ProofStatus  @default(PENDING)
  reviewedAt     DateTime?
  reviewedByName String?
  data           Bytes
  createdAt      DateTime     @default(now())

  @@index([registrationId])
}