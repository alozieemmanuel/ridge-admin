+  throwIfFailed(
+    await deliverAttendeeEmail({
+      source: "REGISTRATION",
+      kind: "test_invite",
+      id: registration.id,
+      to: registration.email,
+      build: () => buildTestInvite(registration, settings),
+    })
+  );
+}
