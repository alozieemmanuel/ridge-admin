diff --git a/src/app/globals.css b/src/app/globals.css
index 578e62a..d8a2756 100644
--- a/src/app/globals.css
+++ b/src/app/globals.css
@@ -90,7 +90,7 @@ select {
 /* Slim, green-tinted horizontal scrollbar for wide tables instead of the bulky default OS scrollbar. */
 .table-scroll {
   scrollbar-width: thin;
-  scrollbar-color: rgba(132, 204, 22, 0.55) transparent;
+  scrollbar-color: rgb(var(--c-golddark) / 0.55) transparent;
 }
 .table-scroll::-webkit-scrollbar {
   height: 8px;
@@ -99,11 +99,21 @@ select {
   background: transparent;
 }
 .table-scroll::-webkit-scrollbar-thumb {
-  background-color: rgba(132, 204, 22, 0.55);
+  background-color: rgb(var(--c-golddark) / 0.55);
   border-radius: 9999px;
 }
 .table-scroll::-webkit-scrollbar-thumb:hover {
-  background-color: rgba(132, 204, 22, 0.8);
+  background-color: rgb(var(--c-golddark) / 0.8);
+}
+/* Vertical scrollbars inside tables and panels follow the same colour. */
+.table-scroll::-webkit-scrollbar:vertical {
+  width: 8px;
+}
+
+/* Checkboxes and radio buttons take the accent colour (the event's own, inside an event). */
+input[type="checkbox"],
+input[type="radio"] {
+  accent-color: rgb(var(--c-gold));
 }
 
 /* Two logo files: the dark one on the light theme, the white one on the dark theme. */
@@ -141,6 +151,24 @@ select {
 .event-themed ::selection {
   background: rgb(var(--c-gold) / 0.35);
 }
+/* The event's own page colour (zero weight, so a class like bg-tint on the same element still wins). */
+:where(.event-themed) {
+  background: rgb(var(--c-pagebg));
+  color: rgb(var(--c-fg));
+}
+:root[data-theme="dark"] .event-themed {
+  --c-pagebg: var(--c-dk-pagebg);
+  --c-cardbg: var(--c-dk-cardbg);
+  --c-inputbg: var(--c-dk-pagebg);
+  --c-border: var(--c-dk-border);
+  --c-muted: var(--c-dk-muted);
+  --c-fg: var(--c-dk-fg);
+}
+:root:not([data-theme="dark"]) .event-themed {
+  --c-border: var(--c-lt-border);
+  --c-muted: var(--c-lt-muted);
+  --c-fg: var(--c-lt-fg);
+}
 .event-themed [class*="141C08"],
 .event-themed .text-black {
   color: rgb(var(--c-on-gold)) !important;
