+      const mine = ++requestId.current;
+      if (!silent) setLoading(true);
+      try {
+        const params = new URLSearchParams({ filter });
+        if (scope.registrationId) params.set("registrationId", scope.registrationId);
+        if (scope.brochureRequestId) params.set("brochureRequestId", scope.brochureRequestId);
+        const res = await fetch(`/api/admin/replies?${params.toString()}`);
+        if (res.ok && mine === requestId.current) {
+          const data = await res.json();
+          setThreads(data.threads);
+          setGmailConfigured(data.gmailConfigured);
+          setSyncError(data.syncError);
+        }
+      } catch {
+        // keep the last list; the next poll retries
