+      {syncError && (
+        <div className="border border-red-400/40 text-red-300 rounded-xl px-5 py-4 text-sm mb-6">
+          Couldn&apos;t check Gmail: {syncError}
+        </div>
+      )}
+
+      <div className="flex gap-2 mb-4 flex-wrap items-center">
+        {(["all", "unread"] as const).map((f) => (
+          <button
+            key={f}
+            onClick={() => setFilter(f)}
+            className={`text-sm px-4 py-2 rounded-full border transition-colors ${
