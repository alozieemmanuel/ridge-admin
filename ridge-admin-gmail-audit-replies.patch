@@ -0,0 +1,117 @@
+import { NextRequest, NextResponse } from "next/server";
+import { prisma } from "@/lib/prisma";
+import { getSession } from "@/lib/auth";
+import { logAdminAction } from "@/lib/audit";
+import { markThreadRead, sendInboxReply } from "@/lib/inbox";
+import { sendReplySchema } from "@/lib/validation";
+
+export const runtime = "nodejs";
+export const maxDuration = 60;
+
+/** One conversation: the original email we sent (if it was one of ours) plus every reply, oldest first. */
+export async function GET(_request: NextRequest, { params }: { params: Promise<{ threadId: string }> }) {
+  const { threadId } = await params;
+
+  const [messages, original] = await Promise.all([
+    prisma.inboxMessage.findMany({ where: { threadId }, orderBy: { occurredAt: "asc" } }),
+    prisma.emailEvent.findFirst({
+      where: { threadId, type: "SENT", audience: "ATTENDEE" },
+      orderBy: { occurredAt: "asc" },
+      select: { kind: true, subject: true, occurredAt: true, provider: true },
+    }),
+  ]);
+
+  if (messages.length === 0) {
+    return NextResponse.json({ error: "Conversation not found." }, { status: 404 });
+  }
+
+  const first = messages[0];
+  const [registration, brochure] = await Promise.all([
+    first.registrationId
+      ? prisma.registration.findUnique({
+          where: { id: first.registrationId },
+          select: { id: true, fullName: true, email: true, phone: true, paymentStatus: true },
+        })
+      : null,
+    first.brochureRequestId
+      ? prisma.brochureRequest.findUnique({
+          where: { id: first.brochureRequestId },
+          select: { id: true, fullName: true, email: true },
+        })
+      : null,
+  ]);
+
+  return NextResponse.json({
+    participant: {
+      name: registration?.fullName ?? brochure?.fullName ?? first.counterpartName ?? first.counterpartAddress,
+      email: first.counterpartAddress,
+      phone: registration?.phone ?? null,
+      registrationId: registration?.id ?? null,
+      brochureRequestId: brochure?.id ?? null,
+    },
+    original: original
+      ? {
+          kind: original.kind,
+          subject: original.subject,
+          sentAt: original.occurredAt.toISOString(),
+        }
+      : null,
+    messages: messages.map((m) => ({
+      id: m.id,
+      direction: m.direction,
+      body: m.bodyText,
+      subject: m.subject,
+      occurredAt: m.occurredAt.toISOString(),
+      readAt: m.readAt ? m.readAt.toISOString() : null,
+      sentByName: m.sentByName,
+    })),
+  });
+}
+
+/** Marks every reply in the conversation as read. */
+export async function PATCH(_request: NextRequest, { params }: { params: Promise<{ threadId: string }> }) {
+  const { threadId } = await params;
+  await markThreadRead(threadId);
+  return NextResponse.json({ result: "success" });
+}
+
+/** Sends the admin's reply inside the participant's Gmail thread. */
+export async function POST(request: NextRequest, { params }: { params: Promise<{ threadId: string }> }) {
+  const { threadId } = await params;
+  const session = await getSession();
+
+  let raw: unknown;
+  try {
+    raw = await request.json();
+  } catch {
+    return NextResponse.json({ error: "Invalid JSON body." }, { status: 400 });
+  }
+  const parsed = sendReplySchema.safeParse(raw);
+  if (!parsed.success) {
+    return NextResponse.json({ error: parsed.error.issues[0]?.message || "Invalid reply." }, { status: 400 });
+  }
+
+  try {
+    const stored = await sendInboxReply({
+      threadId,
+      body: parsed.data.body,
+      adminName: session?.name ?? "Admin",
+    });
+
+    await logAdminAction(
+      session,
+      {
+        action: "reply.send",
+        entityType: stored.registrationId ? "registration" : "brochure_request",
+        entityId: stored.registrationId ?? stored.brochureRequestId ?? undefined,
+        entityLabel: stored.counterpartName ?? stored.counterpartAddress,
+        details: { to: stored.counterpartAddress, subject: stored.subject },
+      },
+      request
+    );
+
+    return NextResponse.json({ result: "success" });
+  } catch (err) {
+    return NextResponse.json({ error: err instanceof Error ? err.message : "Failed to send reply." }, { status: 502 });
+  }
+}
