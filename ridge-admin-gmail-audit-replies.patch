@@ -0,0 +1,241 @@
+/**
+ * The Replies inbox.
+ *
+ * Replies are read from the connected Gmail mailbox (the one transactional mail
+ * is sent from — see src/lib/gmail.ts) and stored as InboxMessage rows so the
+ * admin can read them, mark them read, and answer from /admin/replies.
+ *
+ * A reply is matched to a participant in two ways:
+ *   1. its Gmail thread is one we started (EmailEvent.threadId), or
+ *   2. the sender's address is a registrant's / brochure requester's address
+ *      (this is how replies to Resend campaigns are matched — those are sent
+ *      with Reply-To set to the Gmail mailbox).
+ * Anything else in the mailbox is ignored: this is not a general mail client.
+ *
+ * WhatsApp: InboxMessage.channel already has a WHATSAPP value. When a WhatsApp
+ * Business account exists, the integration only needs to (a) receive Meta's
+ * webhook and insert INBOUND rows here with channel = WHATSAPP, and (b) send
+ * OUTBOUND rows through the WhatsApp Cloud API — the inbox UI and the audit
+ * log need no changes. Nothing WhatsApp-specific is built yet.
+ */
+import { prisma } from "@/lib/prisma";
+import {
+  getMessage,
+  gmailSenderAddress,
+  isGmailConfigured,
+  listMessageIds,
+  sendGmail,
+  stripQuotedReply,
+  GMAIL_NOT_CONFIGURED_MESSAGE,
+} from "@/lib/gmail";
+import { escapeHtml } from "@/lib/email";
+
+const SYNC_AFTER_KEY = "_gmail_sync_after"; // epoch seconds: only fetch mail newer than this
+const SYNCED_AT_KEY = "_gmail_synced_at"; // ISO time of the last sync attempt (throttle)
+const THROTTLE_MS = 45_000;
+const FIRST_SYNC_LOOKBACK_MS = 14 * 24 * 60 * 60 * 1000;
+const OVERLAP_MS = 5 * 60 * 1000; // re-scan a little history each time; duplicates are skipped by id
+const MAX_MESSAGES_PER_SYNC = 200;
+
+export interface SyncResult {
+  ran: boolean;
+  imported: number;
+  bounces: number;
+  error?: string;
+}
+
+async function setSetting(key: string, value: string) {
+  await prisma.setting.upsert({ where: { key }, update: { value }, create: { key, value } });
+}
+
+/**
+ * Pulls new replies from Gmail into the database. Throttled so several open
+ * dashboard tabs don't each hit the Gmail API; pass { force: true } for the
+ * manual "Check for new replies" button. Never throws.
+ */
+export async function syncGmailReplies(opts: { force?: boolean } = {}): Promise<SyncResult> {
+  if (!isGmailConfigured()) return { ran: false, imported: 0, bounces: 0 };
+
+  try {
+    const rows = await prisma.setting.findMany({ where: { key: { in: [SYNC_AFTER_KEY, SYNCED_AT_KEY] } } });
+    const state = Object.fromEntries(rows.map((r) => [r.key, r.value]));
+
+    const lastRun = state[SYNCED_AT_KEY] ? Date.parse(state[SYNCED_AT_KEY]) : 0;
+    if (!opts.force && Date.now() - lastRun < THROTTLE_MS) return { ran: false, imported: 0, bounces: 0 };
+
+    const startedAt = Date.now();
+    await setSetting(SYNCED_AT_KEY, new Date(startedAt).toISOString());
+
+    const afterSeconds = state[SYNC_AFTER_KEY]
+      ? parseInt(state[SYNC_AFTER_KEY], 10)
+      : Math.floor((startedAt - FIRST_SYNC_LOOKBACK_MS) / 1000);
+
+    const listed = await listMessageIds(`in:inbox after:${afterSeconds}`, MAX_MESSAGES_PER_SYNC);
+    const ids = listed.map((m) => m.id);
+
+    const [knownMessages, knownBounces] = await Promise.all([
+      prisma.inboxMessage.findMany({ where: { providerMessageId: { in: ids } }, select: { providerMessageId: true } }),
+      prisma.emailEvent.findMany({
+        where: { providerMessageId: { in: ids }, type: "BOUNCED" },
+        select: { providerMessageId: true },
+      }),
+    ]);
+    const seen = new Set<string>([
+      ...knownMessages.map((m) => m.providerMessageId),
+      ...knownBounces.map((b) => b.providerMessageId ?? ""),
+    ]);
+
+    const sender = gmailSenderAddress()?.toLowerCase();
+    let imported = 0;
+    let bounces = 0;
+
+    for (const { id } of listed) {
+      if (seen.has(id)) continue;
+
+      const msg = await getMessage(id);
+      if (msg.isSent || (sender && msg.fromEmail === sender)) continue;
+
+      const threadEvent = await prisma.emailEvent.findFirst({
+        where: { threadId: msg.threadId, audience: "ATTENDEE", type: "SENT" },
+        select: { registrationId: true, brochureRequestId: true },
+      });
+
+      // Delivery failure notices from Gmail: record as a bounce on the email we sent.
+      if (/mailer-daemon|postmaster/i.test(msg.fromEmail)) {
+        if (threadEvent) {
+          await prisma.emailEvent.create({
+            data: {
+              source: threadEvent.registrationId ? "REGISTRATION" : "BROCHURE",
+              audience: "ATTENDEE",
+              registrationId: threadEvent.registrationId,
+              brochureRequestId: threadEvent.brochureRequestId,
+              type: "BOUNCED",
+              provider: "GMAIL",
+              providerMessageId: msg.id,
+              threadId: msg.threadId,
+              errorMessage: msg.text.replace(/\s+/g, " ").slice(0, 300),
+            },
+          });
+          bounces++;
+        }
+        continue;
+      }
+
+      let registrationId = threadEvent?.registrationId ?? null;
+      let brochureRequestId = threadEvent?.brochureRequestId ?? null;
+      let participantName: string | null = null;
+
+      if (!registrationId && !brochureRequestId) {
+        const registration = await prisma.registration.findFirst({
+          where: { email: { equals: msg.fromEmail, mode: "insensitive" } },
+          select: { id: true, fullName: true },
+        });
+        if (registration) {
+          registrationId = registration.id;
+          participantName = registration.fullName;
+        } else {
+          const brochure = await prisma.brochureRequest.findFirst({
+            where: { email: { equals: msg.fromEmail, mode: "insensitive" } },
+            select: { id: true, fullName: true },
+          });
+          if (!brochure) continue; // not a participant — leave it alone
+          brochureRequestId = brochure.id;
+          participantName = brochure.fullName;
+        }
+      }
+
+      const created = await prisma.inboxMessage.createMany({
+        data: [
+          {
+            channel: "EMAIL",
+            direction: "INBOUND",
+            providerMessageId: msg.id,
+            threadId: msg.threadId,
+            rfcMessageId: msg.rfcMessageId,
+            registrationId,
+            brochureRequestId,
+            counterpartAddress: msg.fromEmail,
+            counterpartName: msg.fromName ?? participantName,
+            subject: (msg.subject || "(no subject)").slice(0, 300),
+            bodyText: stripQuotedReply(msg.text).slice(0, 20000),
+            occurredAt: msg.receivedAt,
+          },
+        ],
+        skipDuplicates: true,
+      });
+      imported += created.count;
+    }
+
+    await setSetting(SYNC_AFTER_KEY, String(Math.floor((startedAt - OVERLAP_MS) / 1000)));
+    return { ran: true, imported, bounces };
+  } catch (err) {
+    console.error("[inbox] Gmail sync failed:", err);
+    return { ran: true, imported: 0, bounces: 0, error: err instanceof Error ? err.message : String(err) };
+  }
+}
+
+export async function unreadReplyCount(): Promise<number> {
+  return prisma.inboxMessage.count({ where: { direction: "INBOUND", readAt: null } });
+}
+
+export async function markThreadRead(threadId: string): Promise<void> {
+  await prisma.inboxMessage.updateMany({
+    where: { threadId, direction: "INBOUND", readAt: null },
+    data: { readAt: new Date() },
+  });
+}
+
+/**
+ * Sends an admin's reply inside the participant's existing Gmail thread and
+ * stores it so it appears in the conversation. Throws with a readable message.
+ */
+export async function sendInboxReply(opts: { threadId: string; body: string; adminName: string }) {
+  if (!isGmailConfigured()) throw new Error(GMAIL_NOT_CONFIGURED_MESSAGE);
+
+  const messages = await prisma.inboxMessage.findMany({
+    where: { threadId: opts.threadId },
+    orderBy: { occurredAt: "asc" },
+  });
+  const lastInbound = [...messages].reverse().find((m) => m.direction === "INBOUND");
+  if (!lastInbound) throw new Error("This conversation has no reply to answer.");
+
+  const subject = /^re:/i.test(lastInbound.subject) ? lastInbound.subject : `Re: ${lastInbound.subject}`;
+  const references = messages.map((m) => m.rfcMessageId).filter((v): v is string => Boolean(v));
+
+  const html = `<div style="font-family:Arial,sans-serif;font-size:14px;line-height:1.6;color:#111;">${escapeHtml(
+    opts.body
+  ).replace(/\n/g, "<br/>")}</div>`;
+
+  const sent = await sendGmail({
+    to: lastInbound.counterpartAddress,
+    subject,
+    html,
+    text: opts.body,
+    fromName: process.env.EMAIL_FROM_NAME || "RIDGE 2026",
+    threadId: opts.threadId,
+    inReplyTo: lastInbound.rfcMessageId ?? undefined,
+    references: references.length ? references.join(" ") : undefined,
+  });
+
+  const now = new Date();
+  const stored = await prisma.inboxMessage.create({
+    data: {
+      channel: "EMAIL",
+      direction: "OUTBOUND",
+      providerMessageId: sent.id,
+      threadId: sent.threadId,
+      registrationId: lastInbound.registrationId,
+      brochureRequestId: lastInbound.brochureRequestId,
+      counterpartAddress: lastInbound.counterpartAddress,
+      counterpartName: lastInbound.counterpartName,
+      subject,
+      bodyText: opts.body,
+      occurredAt: now,
+      readAt: now,
+      sentByName: opts.adminName,
+    },
+  });
+
+  await markThreadRead(opts.threadId);
+  return stored;
+}
