@@ -0,0 +1,87 @@
+import { NextRequest, NextResponse } from "next/server";
+import { prisma } from "@/lib/prisma";
+import { isGmailConfigured } from "@/lib/gmail";
+import { syncGmailReplies } from "@/lib/inbox";
+
+export const runtime = "nodejs";
+export const maxDuration = 60;
+
+/**
+ * Conversation list for the Replies inbox: one row per Gmail thread that has at
+ * least one participant reply, newest activity first. Also triggers a
+ * (throttled) sync so new replies show up without anyone clicking anything.
+ *
+ * Query: filter=all|unread, registrationId=…, brochureRequestId=…
+ */
+export async function GET(request: NextRequest) {
+  const { searchParams } = request.nextUrl;
+  const filter = searchParams.get("filter") === "unread" ? "unread" : "all";
+  const registrationId = searchParams.get("registrationId") || undefined;
+  const brochureRequestId = searchParams.get("brochureRequestId") || undefined;
+
+  const sync = await syncGmailReplies();
+
+  const messages = await prisma.inboxMessage.findMany({
+    where: { channel: "EMAIL", registrationId, brochureRequestId },
+    orderBy: { occurredAt: "desc" },
+    take: 1500,
+    include: {
+      registration: { select: { id: true, fullName: true } },
+      brochureRequest: { select: { id: true, fullName: true } },
+    },
+  });
+
+  interface Thread {
+    threadId: string;
+    participantName: string;
+    participantEmail: string;
+    registrationId: string | null;
+    brochureRequestId: string | null;
+    subject: string;
+    lastMessageAt: string;
+    lastSnippet: string;
+    lastDirection: "INBOUND" | "OUTBOUND";
+    unreadCount: number;
+    messageCount: number;
+    hasInbound: boolean;
+  }
+
+  const threads = new Map<string, Thread>();
+  for (const m of messages) {
+    // messages are newest-first, so the first one seen for a thread is its latest
+    let t = threads.get(m.threadId);
+    if (!t) {
+      t = {
+        threadId: m.threadId,
+        participantName: m.registration?.fullName ?? m.brochureRequest?.fullName ?? m.counterpartName ?? m.counterpartAddress,
+        participantEmail: m.counterpartAddress,
+        registrationId: m.registrationId,
+        brochureRequestId: m.brochureRequestId,
+        subject: m.subject,
+        lastMessageAt: m.occurredAt.toISOString(),
+        lastSnippet: m.bodyText.replace(/\s+/g, " ").slice(0, 140),
+        lastDirection: m.direction,
+        unreadCount: 0,
+        messageCount: 0,
+        hasInbound: false,
+      };
+      threads.set(m.threadId, t);
+    }
+    t.messageCount += 1;
+    if (m.direction === "INBOUND") {
+      t.hasInbound = true;
+      if (!m.readAt) t.unreadCount += 1;
+    }
+  }
+
+  let list = [...threads.values()].filter((t) => t.hasInbound);
+  const totalUnread = list.reduce((sum, t) => sum + t.unreadCount, 0);
+  if (filter === "unread") list = list.filter((t) => t.unreadCount > 0);
+
+  return NextResponse.json({
+    threads: list,
+    totalUnread,
+    gmailConfigured: isGmailConfigured(),
+    syncError: sync.error ?? null,
+  });
+}
