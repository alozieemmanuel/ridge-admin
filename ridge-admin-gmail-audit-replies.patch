+        body: JSON.stringify({ body: reply }),
+      });
+      const data = await res.json().catch(() => ({}));
+      if (res.ok) {
+        setReply("");
+        flash("Reply sent.", true);
+        await loadConversation(selected, true);
+        loadThreads(true);
+      } else {
+        flash(data.error || "Failed to send reply.", false);
+      }
+    } finally {
+      setSending(false);
+    }
+  }
+
+  const totalUnread = threads.reduce((sum, t) => sum + t.unreadCount, 0);
+  const scoped = Boolean(scope.registrationId || scope.brochureRequestId);
+
+  return (
+    <AdminShell active="/admin/replies">
+      <div className="flex items-center justify-between flex-wrap gap-4 mb-6">
+        <div>
+          <h2 className="font-serif text-2xl">Replies</h2>
+          <p className="text-muted text-sm mt-1">
+            {threads.length} conversation{threads.length === 1 ? "" : "s"}
+            {totalUnread > 0 && ` · ${totalUnread} unread`}
+            {message && <span className={`ml-3 ${message.ok ? "text-goldlight" : "text-red-400"}`}>{message.text}</span>}
+          </p>
+        </div>
+        <button
+          onClick={handleCheckNow}
+          disabled={checking || !gmailConfigured}
+          className="text-sm px-5 py-2.5 rounded-full border border-border hover:border-gold disabled:opacity-60 whitespace-nowrap"
+        >
+          {checking ? "Checking…" : "Check for new replies"}
+        </button>
+      </div>
