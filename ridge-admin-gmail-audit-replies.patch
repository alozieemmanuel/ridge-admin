+import { NextResponse } from "next/server";
+import { syncGmailReplies } from "@/lib/inbox";
+import { isGmailConfigured, GMAIL_NOT_CONFIGURED_MESSAGE } from "@/lib/gmail";
+
+export const runtime = "nodejs";
+export const maxDuration = 60;
+
+/** The "Check for new replies" button: sync now, ignoring the throttle. */
+export async function POST() {
+  if (!isGmailConfigured()) {
+    return NextResponse.json({ error: GMAIL_NOT_CONFIGURED_MESSAGE }, { status: 400 });
+  }
+  const result = await syncGmailReplies({ force: true });
+  if (result.error) return NextResponse.json({ error: result.error }, { status: 502 });
+  return NextResponse.json({ result: "success", imported: result.imported, bounces: result.bounces });
+}
