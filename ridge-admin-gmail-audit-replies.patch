diff --git a/src/lib/gmail.ts b/src/lib/gmail.ts
new file mode 100644
index 0000000..f9c41c9
--- /dev/null
+++ b/src/lib/gmail.ts
@@ -0,0 +1,340 @@
+/**
+ * Minimal Gmail API client (no SDK — just fetch), used for:
+ *   - sending transactional mail (confirmations, reminders, seat invites, replies)
+ *   - reading replies back into the admin's Replies inbox
+ *
+ * Auth is OAuth2 with a long-lived refresh token for ONE mailbox (the one the
+ * emails are sent from). Required environment variables:
+ *   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GMAIL_REFRESH_TOKEN, GMAIL_SENDER
+ * Required OAuth scopes when generating the refresh token:
+ *   https://www.googleapis.com/auth/gmail.send
+ *   https://www.googleapis.com/auth/gmail.readonly
+ */
+
+const TOKEN_URL = "https://oauth2.googleapis.com/token";
+const API_BASE = "https://gmail.googleapis.com/gmail/v1/users/me";
+
+export function isGmailConfigured(): boolean {
+  return Boolean(
+    process.env.GOOGLE_CLIENT_ID &&
+      process.env.GOOGLE_CLIENT_SECRET &&
+      process.env.GMAIL_REFRESH_TOKEN &&
+      process.env.GMAIL_SENDER
+  );
+}
+
+export const GMAIL_NOT_CONFIGURED_MESSAGE =
+  "Gmail isn't connected on the server. Set GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GMAIL_REFRESH_TOKEN and GMAIL_SENDER.";
+
+export function gmailSenderAddress(): string | null {
+  return process.env.GMAIL_SENDER?.trim() || null;
+}
+
+export class GmailError extends Error {
+  status: number;
+  constructor(message: string, status: number) {
+    super(message);
+    this.name = "GmailError";
+    this.status = status;
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Auth
+// ---------------------------------------------------------------------------
+
+let cachedToken: { value: string; expiresAt: number } | null = null;
+
+async function getAccessToken(): Promise<string> {
+  if (cachedToken && cachedToken.expiresAt > Date.now() + 60_000) return cachedToken.value;
+
+  const res = await fetch(TOKEN_URL, {
+    method: "POST",
+    headers: { "Content-Type": "application/x-www-form-urlencoded" },
+    body: new URLSearchParams({
+      client_id: process.env.GOOGLE_CLIENT_ID || "",
+      client_secret: process.env.GOOGLE_CLIENT_SECRET || "",
+      refresh_token: process.env.GMAIL_REFRESH_TOKEN || "",
+      grant_type: "refresh_token",
+    }),
+  });
+
+  if (!res.ok) {
+    const text = await res.text();
+    let reason = text.slice(0, 200);
+    try {
+      const parsed = JSON.parse(text) as { error?: string; error_description?: string };
+      reason = [parsed.error, parsed.error_description].filter(Boolean).join(": ") || reason;
+    } catch {
+      // keep the raw text
+    }
+    // invalid_grant almost always means the refresh token was revoked or (for an
+    // app left in "Testing" mode) expired after 7 days.
+    throw new GmailError(`Gmail sign-in failed (${reason}). The refresh token may have expired or been revoked.`, res.status);
+  }
+
+  const data = (await res.json()) as { access_token: string; expires_in: number };
+  cachedToken = { value: data.access_token, expiresAt: Date.now() + data.expires_in * 1000 };
+  return data.access_token;
+}
+
+async function gmailFetch<T>(path: string, init?: RequestInit): Promise<T> {
+  const token = await getAccessToken();
+  const res = await fetch(`${API_BASE}${path}`, {
+    ...init,
+    headers: {
+      Authorization: `Bearer ${token}`,
+      "Content-Type": "application/json",
+      ...(init?.headers ?? {}),
+    },
+  });
+
+  if (!res.ok) {
+    const text = await res.text();
+    let reason = text.slice(0, 300);
+    try {
+      const parsed = JSON.parse(text) as { error?: { message?: string } };
+      if (parsed.error?.message) reason = parsed.error.message;
+    } catch {
+      // keep the raw text
+    }
+    throw new GmailError(`Gmail ${res.status}: ${reason}`, res.status);
+  }
+  return (await res.json()) as T;
+}
+
+// ---------------------------------------------------------------------------
+// MIME building
+// ---------------------------------------------------------------------------
+
+function base64Url(input: string | Buffer): string {
+  return Buffer.from(input).toString("base64").replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
+}
+
+/** Standard base64 wrapped at 76 chars, as MIME requires. */
+function base64Wrapped(input: string): string {
+  return (Buffer.from(input, "utf-8").toString("base64").match(/.{1,76}/g) ?? []).join("\r\n");
+}
+
+/** RFC 2047 encoding for header text that isn't plain ASCII (names, subjects). */
+function encodeHeaderText(value: string): string {
+  // eslint-disable-next-line no-control-regex
+  if (/^[\x00-\x7F]*$/.test(value)) return value;
+  return `=?UTF-8?B?${Buffer.from(value, "utf-8").toString("base64")}?=`;
+}
+
+/** Strips CR/LF so a value can never inject extra headers. */
+function cleanHeader(value: string): string {
+  return value.replace(/[\r\n]+/g, " ").trim();
+}
+
+function formatAddress(address: string, displayName?: string): string {
+  const a = cleanHeader(address);
+  if (!displayName) return a;
+  const name = cleanHeader(displayName).replace(/"/g, "");
+  return `"${encodeHeaderText(name)}" <${a}>`;
+}
+
+export function htmlToPlainText(html: string): string {
+  return html
+    .replace(/<style[\s\S]*?<\/style>/gi, "")
+    .replace(/<br\s*\/?>/gi, "\n")
+    .replace(/<\/(p|div|tr|h[1-6])>/gi, "\n\n")
+    .replace(/<\/t[dh]>/gi, "  ")
+    .replace(/<a [^>]*href="([^"]+)"[^>]*>([\s\S]*?)<\/a>/gi, "$2 ($1)")
+    .replace(/<[^>]+>/g, "")
+    .replace(/&nbsp;/g, " ")
+    .replace(/&lt;/g, "<")
+    .replace(/&gt;/g, ">")
+    .replace(/&quot;/g, '"')
+    .replace(/&amp;/g, "&")
+    .replace(/[ \t]+\n/g, "\n")
+    .replace(/\n{3,}/g, "\n\n")
+    .trim();
+}
+
+export interface GmailSendInput {
+  to: string;
+  subject: string;
+  html: string;
+  text?: string;
+  replyTo?: string | null;
+  fromName?: string;
+  /** Send inside an existing Gmail thread (a reply). */
+  threadId?: string;
+  inReplyTo?: string;
+  references?: string;
+}
+
+export function buildRawMessage(input: GmailSendInput): string {
+  const from = formatAddress(gmailSenderAddress() || "", input.fromName);
+  const boundary = `ridge_${Date.now().toString(36)}_${Math.random().toString(36).slice(2, 10)}`;
+  const text = input.text ?? htmlToPlainText(input.html);
+
+  const headers = [
+    `From: ${from}`,
+    `To: ${cleanHeader(input.to)}`,
+    input.replyTo ? `Reply-To: ${cleanHeader(input.replyTo)}` : null,
+    `Subject: ${encodeHeaderText(cleanHeader(input.subject))}`,
+    input.inReplyTo ? `In-Reply-To: ${cleanHeader(input.inReplyTo)}` : null,
+    input.references ? `References: ${cleanHeader(input.references)}` : null,
+    "MIME-Version: 1.0",
+    `Content-Type: multipart/alternative; boundary="${boundary}"`,
+  ].filter((h): h is string => h !== null);
+
+  const body = [
+    `--${boundary}`,
+    'Content-Type: text/plain; charset="UTF-8"',
+    "Content-Transfer-Encoding: base64",
+    "",
+    base64Wrapped(text),
+    `--${boundary}`,
+    'Content-Type: text/html; charset="UTF-8"',
+    "Content-Transfer-Encoding: base64",
+    "",
+    base64Wrapped(input.html),
+    `--${boundary}--`,
+    "",
+  ];
+
+  return base64Url([...headers, "", ...body].join("\r\n"));
+}
+
+// ---------------------------------------------------------------------------
+// Sending
+// ---------------------------------------------------------------------------
+
+export async function sendGmail(input: GmailSendInput): Promise<{ id: string; threadId: string }> {
+  const raw = buildRawMessage(input);
+  const result = await gmailFetch<{ id: string; threadId: string }>("/messages/send", {
+    method: "POST",
+    body: JSON.stringify(input.threadId ? { raw, threadId: input.threadId } : { raw }),
+  });
+  return { id: result.id, threadId: result.threadId };
+}
+
+// ---------------------------------------------------------------------------
+// Reading
+// ---------------------------------------------------------------------------
+
+interface GmailPart {
+  mimeType?: string;
+  body?: { data?: string };
+  parts?: GmailPart[];
+}
+
+interface GmailMessageResource {
+  id: string;
+  threadId: string;
+  internalDate?: string;
+  snippet?: string;
+  labelIds?: string[];
+  payload?: GmailPart & { headers?: { name: string; value: string }[] };
+}
+
+export async function listMessageIds(query: string, maxResults = 100): Promise<{ id: string; threadId: string }[]> {
+  const found: { id: string; threadId: string }[] = [];
+  let pageToken: string | undefined;
+  do {
+    const params = new URLSearchParams({ q: query, maxResults: String(Math.min(100, maxResults - found.length)) });
+    if (pageToken) params.set("pageToken", pageToken);
+    const page = await gmailFetch<{ messages?: { id: string; threadId: string }[]; nextPageToken?: string }>(
+      `/messages?${params.toString()}`
+    );
+    found.push(...(page.messages ?? []));
+    pageToken = page.nextPageToken;
+  } while (pageToken && found.length < maxResults);
+  return found;
+}
+
+function decodeBase64Url(data: string): string {
+  return Buffer.from(data.replace(/-/g, "+").replace(/_/g, "/"), "base64").toString("utf-8");
+}
+
+function findPart(part: GmailPart | undefined, mimeType: string): string | null {
+  if (!part) return null;
+  if (part.mimeType === mimeType && part.body?.data) return decodeBase64Url(part.body.data);
+  for (const child of part.parts ?? []) {
+    const found = findPart(child, mimeType);
+    if (found) return found;
+  }
+  return null;
+}
+
+export interface ParsedGmailMessage {
+  id: string;
+  threadId: string;
+  from: string;
+  fromEmail: string;
+  fromName: string | null;
+  to: string;
+  subject: string;
+  rfcMessageId: string | null;
+  autoSubmitted: boolean;
+  receivedAt: Date;
+  text: string;
+  isSent: boolean;
+}
+
+/** "Jane Doe <jane@x.com>" or "jane@x.com" -> { email, name } */
+export function parseAddress(value: string): { email: string; name: string | null } {
+  const match = value.match(/^\s*"?([^"<]*?)"?\s*<([^>]+)>\s*$/);
+  if (match) return { email: match[2].trim().toLowerCase(), name: match[1].trim() || null };
+  return { email: value.trim().toLowerCase(), name: null };
+}
+
+/**
+ * Cuts the quoted original out of a reply ("On <date>, X wrote:" and everything
+ * after it) so the inbox shows just what the person actually typed. Best-effort:
+ * if nothing is left after trimming, the full text is returned instead.
+ */
+export function stripQuotedReply(text: string): string {
+  const normalized = text.replace(/\r\n/g, "\n");
+  const cutPatterns = [
+    /\n\s*On [\s\S]{5,250}?wrote:\s*\n/i,
+    /\n\s*-{2,}\s*Original Message\s*-{2,}/i,
+    /\n\s*_{5,}\s*\n\s*From:/i,
+    /\n\s*From: .+\n\s*Sent: /i,
+  ];
+  let cut = normalized.length;
+  for (const pattern of cutPatterns) {
+    const m = pattern.exec(normalized);
+    if (m && m.index < cut) cut = m.index;
+  }
+  const trimmed = normalized
+    .slice(0, cut)
+    .split("\n")
+    .filter((line, i, all) => !(line.trim().startsWith(">") && all.slice(i).every((l) => l.trim().startsWith(">") || !l.trim())))
+    .join("\n")
+    .trim();
+  return trimmed || normalized.trim();
+}
+
+export async function getMessage(id: string): Promise<ParsedGmailMessage> {
+  const msg = await gmailFetch<GmailMessageResource>(`/messages/${id}?format=full`);
+  const headers = msg.payload?.headers ?? [];
+  const header = (name: string) => headers.find((h) => h.name.toLowerCase() === name.toLowerCase())?.value ?? "";
+
+  const from = header("From");
+  const parsedFrom = parseAddress(from);
+  const plain = findPart(msg.payload, "text/plain");
+  const html = findPart(msg.payload, "text/html");
+  const text = plain ?? (html ? htmlToPlainText(html) : msg.snippet ?? "");
+
+  const autoSubmitted = /auto-(replied|generated)/i.test(header("Auto-Submitted")) || /bulk|auto_reply/i.test(header("Precedence"));
+
+  return {
+    id: msg.id,
+    threadId: msg.threadId,
+    from,
+    fromEmail: parsedFrom.email,
+    fromName: parsedFrom.name,
+    to: header("To"),
+    subject: header("Subject"),
+    rfcMessageId: header("Message-ID") || header("Message-Id") || null,
+    autoSubmitted,
+    receivedAt: msg.internalDate ? new Date(parseInt(msg.internalDate, 10)) : new Date(),
+    text,
+    isSent: (msg.labelIds ?? []).includes("SENT"),
+  };
+}
