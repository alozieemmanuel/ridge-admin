diff --git a/src/app/new/page.tsx b/src/app/new/page.tsx
new file mode 100644
index 0000000..b86b479
--- /dev/null
+++ b/src/app/new/page.tsx
@@ -0,0 +1,161 @@
+"use client";
+
+import { useEffect, useState } from "react";
+import Link from "next/link";
+import { useRouter } from "next/navigation";
+import AdminShell from "@/components/AdminShell";
+import { PageHeader, ghostButton, inputClass, primaryButton } from "@/components/ui";
+import { EVENT_MODULES } from "@/lib/eventModules";
+import { cacheDeletePrefix } from "@/lib/clientCache";
+import { BASE_PATH } from "@/lib/basePath";
+
+function slugify(name: string): string {
+  return name
+    .toLowerCase()
+    .normalize("NFKD")
+    .replace(/[̀-ͯ]/g, "")
+    .replace(/[^a-z0-9]+/g, "-")
+    .replace(/^-+|-+$/g, "")
+    .slice(0, 60);
+}
+
+/** Owner only: create an event. It starts empty, with its own contacts, settings, emails and live sheet. */
+export default function NewEventPage() {
+  const router = useRouter();
+  const [name, setName] = useState("");
+  const [slug, setSlug] = useState("");
+  const [slugEdited, setSlugEdited] = useState(false);
+  const [modules, setModules] = useState<string[]>(EVENT_MODULES.map((m) => m.key));
+  const [sheetUrl, setSheetUrl] = useState("");
+  const [copyFrom, setCopyFrom] = useState("");
+  const [others, setOthers] = useState<{ id: string; name: string }[]>([]);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+
+  useEffect(() => {
+    fetch("/api/events")
+      .then((r) => (r.ok ? r.json() : null))
+      .then((d) => d && setOthers(d.events.map((e: { id: string; name: string }) => ({ id: e.id, name: e.name }))))
+      .catch(() => undefined);
+  }, []);
+
+  async function submit(e: React.FormEvent) {
+    e.preventDefault();
+    setBusy(true);
+    setError(null);
+    const res = await fetch("/api/events", {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({ name, slug, modules, sheetUrl, copyFrom: copyFrom || undefined }),
+    }).catch(() => null);
+    const json = res ? await res.json().catch(() => ({})) : {};
+    if (!res || !res.ok) {
+      setError(json.error || "Couldn't create the event. Try again.");
+      setBusy(false);
+      return;
+    }
+    cacheDeletePrefix("/api/events");
+    router.push(`/${json.event.slug}/contacts`);
+  }
+
+  return (
+    <AdminShell>
+      <PageHeader title="New event" subtitle="It gets its own contacts, settings, emails and live sheet. Nothing is shared with your other events." />
+      <form onSubmit={submit} className="border border-border rounded-xl p-6 space-y-6 max-w-2xl">
+        <div>
+          <label className="block text-xs uppercase tracking-wider text-muted mb-2" htmlFor="ev-name">
+            Event name
+          </label>
+          <input
+            id="ev-name"
+            required
+            value={name}
+            onChange={(e) => {
+              setName(e.target.value);
+              if (!slugEdited) setSlug(slugify(e.target.value));
+            }}
+            placeholder="e.g. Investor Hangout"
+            className={inputClass}
+          />
+        </div>
+
+        <div>
+          <label className="block text-xs uppercase tracking-wider text-muted mb-2" htmlFor="ev-slug">
+            Web address
+          </label>
+          <div className="flex items-center gap-2 text-sm">
+            <span className="text-muted whitespace-nowrap">{`${BASE_PATH}/`}</span>
+            <input
+              id="ev-slug"
+              required
+              value={slug}
+              onChange={(e) => {
+                setSlug(slugify(e.target.value));
+                setSlugEdited(true);
+              }}
+              className={inputClass}
+            />
+          </div>
+          <p className="text-xs text-muted mt-1.5">Guests&apos; reserve links use this address. It can&apos;t be changed later.</p>
+        </div>
+
+        <div>
+          <p className="text-xs uppercase tracking-wider text-muted mb-2">What this event uses</p>
+          <p className="text-xs text-muted mb-3">Contacts, the live sheet and settings are always on. You can change the rest later in Settings.</p>
+          <div className="space-y-3">
+            {EVENT_MODULES.map((m) => (
+              <label key={m.key} className="flex items-start gap-3 text-sm cursor-pointer">
+                <input
+                  type="checkbox"
+                  className="mt-1 accent-[#b8963e]"
+                  checked={modules.includes(m.key)}
+                  onChange={(e) => setModules((cur) => (e.target.checked ? [...cur, m.key] : cur.filter((x) => x !== m.key)))}
+                />
+                <span>
+                  <span className="font-medium">{m.label}</span>
+                  <span className="block text-xs text-muted">{m.hint}</span>
+                </span>
+              </label>
+            ))}
+          </div>
+        </div>
+
+        <div>
+          <label className="block text-xs uppercase tracking-wider text-muted mb-2" htmlFor="ev-sheet">
+            Live Google Sheet (optional)
+          </label>
+          <input id="ev-sheet" value={sheetUrl} onChange={(e) => setSheetUrl(e.target.value)} placeholder="https://docs.google.com/spreadsheets/d/…" className={inputClass} />
+          <p className="text-xs text-muted mt-1.5">You can paste it now or later on the Contacts page. Share the sheet as &quot;Anyone with the link can view&quot;.</p>
+        </div>
+
+        {others.length > 0 && (
+          <div>
+            <label className="block text-xs uppercase tracking-wider text-muted mb-2" htmlFor="ev-copy">
+              Start from another event&apos;s settings and emails (optional)
+            </label>
+            <select id="ev-copy" value={copyFrom} onChange={(e) => setCopyFrom(e.target.value)} className={inputClass}>
+              <option value="">No, start fresh</option>
+              {others.map((o) => (
+                <option key={o.id} value={o.id}>
+                  {o.name}
+                </option>
+              ))}
+            </select>
+            <p className="text-xs text-muted mt-1.5">Copies the sender name, contact details and email wording. Contacts, dates and seat limit are not copied.</p>
+          </div>
+        )}
+
+        {error && <p className="text-sm text-red-400">{error}</p>}
+
+        <div className="flex items-center gap-3">
+          <button type="submit" disabled={busy || name.trim().length < 2 || slug.length < 2} className={primaryButton}>
+            {busy ? "Creating…" : "Create event"}
+          </button>
+          <Link href="/" className={ghostButton}>
+            Cancel
+          </Link>
+        </div>
+      </form>
+    </AdminShell>
+  );
+}
