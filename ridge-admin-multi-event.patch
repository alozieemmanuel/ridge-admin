--- /dev/null
+++ b/src/app/api/admin/event/route.ts
@@ -0,0 +1,46 @@
+import { NextRequest, NextResponse } from "next/server";
+import { prisma } from "@/lib/prisma";
+import { logAdminAction } from "@/lib/audit";
+import { MODULE_KEYS, requireEvent } from "@/lib/event";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+/** The open event, for the dashboard shell: its name, which parts are on, and who is looking. */
+export async function GET(request: NextRequest) {
+  const ctx = await requireEvent(request);
+  if (!ctx.ok) return ctx.response;
+  const { event, session } = ctx;
+  return NextResponse.json({
+    event: { id: event.id, slug: event.slug, name: event.name, status: event.status, modules: event.modules },
+    role: session.role,
+    admin: { name: session.name, email: session.email },
+  });
+}
+
+/** Owner only. Body: { modules?: string[], status?: "ACTIVE" | "ARCHIVED" }. The name is changed in Settings. */
+export async function PATCH(request: NextRequest) {
+  const ctx = await requireEvent(request, { owner: true });
+  if (!ctx.ok) return ctx.response;
+  const { event, session } = ctx;
+
+  let body: { modules?: unknown; status?: unknown };
+  try {
+    body = await request.json();
+  } catch {
+    return NextResponse.json({ error: "Invalid request." }, { status: 400 });
+  }
+
+  const data: { modules?: string[]; status?: "ACTIVE" | "ARCHIVED" } = {};
+  if (Array.isArray(body.modules)) {
+    // Parts that are not offered in the creation form (WhatsApp, for now) are kept as they are.
+    const chosen = body.modules.filter((m): m is string => typeof m === "string" && MODULE_KEYS.includes(m));
+    data.modules = Array.from(new Set([...event.modules.filter((m) => !MODULE_KEYS.includes(m)), ...chosen]));
+  }
+  if (body.status === "ACTIVE" || body.status === "ARCHIVED") data.status = body.status;
+  if (!Object.keys(data).length) return NextResponse.json({ error: "Nothing to change." }, { status: 400 });
+
+  const updated = await prisma.event.update({ where: { id: event.id }, data });
+  await logAdminAction(session, { action: "event.update", entityType: "event", entityId: event.id, entityLabel: event.name, eventId: event.id, details: data }, request);
+  return NextResponse.json({ result: "success", event: { id: updated.id, slug: updated.slug, name: updated.name, status: updated.status, modules: updated.modules } });
+}
