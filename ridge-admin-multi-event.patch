diff --git a/src/app/api/events/route.ts b/src/app/api/events/route.ts
new file mode 100644
index 0000000..cfa5c51
--- /dev/null
+++ b/src/app/api/events/route.ts
@@ -0,0 +1,129 @@
+import { NextRequest, NextResponse } from "next/server";
+import { prisma } from "@/lib/prisma";
+import { getSession } from "@/lib/auth";
+import { logAdminAction } from "@/lib/audit";
+import { DEFAULT_SETTINGS } from "@/lib/settings";
+import { DEFAULT_EMAIL_TEMPLATES } from "@/lib/emailDefaults";
+import { MODULE_KEYS, slugify, validateSlug } from "@/lib/event";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+interface StatRow {
+  eventId: string;
+  total: number;
+  invited: number;
+  reserved: number;
+  checked: number;
+  contacted: number;
+}
+
+/**
+ * The event picker. Lists the events this admin can open (owners: all of them), with the numbers shown on each card.
+ * One grouped query does all the counting, so the picker stays quick however many events there are.
+ */
+export async function GET() {
+  const session = await getSession();
+  if (!session) return NextResponse.json({ error: "Not signed in." }, { status: 401 });
+
+  const isOwner = session.role === "OWNER";
+  const events = await prisma.event.findMany({
+    where: isOwner ? {} : { admins: { some: { adminId: session.adminId } } },
+    orderBy: [{ status: "asc" }, { createdAt: "asc" }],
+  });
+  const ids = events.map((e) => e.id);
+
+  const stats = ids.length
+    ? await prisma.$queryRaw<StatRow[]>`
+        SELECT "eventId",
+               count(*)::int AS total,
+               (count(*) FILTER (WHERE "inviteSentAt" IS NOT NULL OR "reservedAt" IS NOT NULL))::int AS invited,
+               count("reservedAt")::int AS reserved,
+               count("checkedInAt")::int AS checked,
+               (count(*) FILTER (WHERE "followUpStatus" <> 'NOT_CONTACTED'))::int AS contacted
+        FROM "Registration"
+        WHERE "eventId" = ANY(${ids})
+        GROUP BY "eventId"`
+    : [];
+  const byEvent = new Map(stats.map((s) => [s.eventId, s]));
+
+  const capacities = ids.length ? await prisma.setting.findMany({ where: { eventId: { in: ids }, key: "seat_capacity" } }) : [];
+  const capById = new Map(capacities.map((c) => [c.eventId, c.value]));
+
+  return NextResponse.json({
+    isOwner,
+    events: events.map((e) => {
+      const s = byEvent.get(e.id);
+      const cap = parseInt(capById.get(e.id) ?? "", 10);
+      return {
+        id: e.id,
+        slug: e.slug,
+        name: e.name,
+        status: e.status,
+        modules: e.modules,
+        total: s?.total ?? 0,
+        invited: s?.invited ?? 0,
+        reserved: s?.reserved ?? 0,
+        checkedIn: s?.checked ?? 0,
+        contacted: s?.contacted ?? 0,
+        capacity: Number.isFinite(cap) && cap > 0 ? cap : null,
+      };
+    }),
+  });
+}
+
+/**
+ * Creates an event (owner only). Body: { name, slug?, modules: string[], copyFrom?: eventId, sheetUrl? }
+ * The new event starts empty, with its own settings and email templates. "copyFrom" copies another event's settings
+ * (venue, sender name, capacity...) and email wording so the new one doesn't start from zero.
+ */
+export async function POST(request: NextRequest) {
+  const session = await getSession();
+  if (!session || session.role !== "OWNER") return NextResponse.json({ error: "Only an owner can create events." }, { status: 403 });
+
+  let body: { name?: unknown; slug?: unknown; modules?: unknown; copyFrom?: unknown; sheetUrl?: unknown };
+  try {
+    body = await request.json();
+  } catch {
+    return NextResponse.json({ error: "Invalid request." }, { status: 400 });
+  }
+
+  const name = typeof body.name === "string" ? body.name.trim() : "";
+  if (name.length < 2 || name.length > 120) return NextResponse.json({ error: "Give the event a name (2 to 120 characters)." }, { status: 400 });
+
+  const slug = (typeof body.slug === "string" && body.slug.trim() ? body.slug.trim().toLowerCase() : slugify(name)).replace(/\s+/g, "-");
+  const slugError = validateSlug(slug);
+  if (slugError) return NextResponse.json({ error: slugError }, { status: 400 });
+  if (await prisma.event.findUnique({ where: { slug }, select: { id: true } })) return NextResponse.json({ error: "Another event already uses that address." }, { status: 409 });
+
+  const modules = Array.isArray(body.modules) ? Array.from(new Set(body.modules.filter((m): m is string => typeof m === "string" && MODULE_KEYS.includes(m)))) : [];
+
+  // Settings and emails to start from: another event's, or the built-in defaults.
+  let settings: Record<string, string> = { ...DEFAULT_SETTINGS };
+  let templates: { key: string; subject: string; body: string; replyTo: string | null }[] = DEFAULT_EMAIL_TEMPLATES.map((t) => ({ key: t.key, subject: t.subject, body: t.body, replyTo: t.replyTo ?? null }));
+  if (typeof body.copyFrom === "string" && body.copyFrom) {
+    const [rows, tpls] = await Promise.all([
+      prisma.setting.findMany({ where: { eventId: body.copyFrom } }),
+      prisma.emailTemplate.findMany({ where: { eventId: body.copyFrom } }),
+    ]);
+    if (rows.length) settings = { ...settings, ...Object.fromEntries(rows.map((r) => [r.key, r.value])) };
+    if (tpls.length) templates = tpls.map((t) => ({ key: t.key, subject: t.subject, body: t.body, replyTo: t.replyTo }));
+  }
+  // The event's own details never carry over from the one it was copied from.
+  for (const k of ["contacts_sheet_url", "contacts_sheet_last_sync", "seat_capacity", "event_date", "event_time"]) delete settings[k];
+  settings.programme_name = name;
+  if (typeof body.sheetUrl === "string" && body.sheetUrl.trim()) settings.contacts_sheet_url = body.sheetUrl.trim();
+
+  const event = await prisma.event.create({
+    data: {
+      slug,
+      name,
+      modules,
+      settings: { create: Object.entries(settings).map(([key, value]) => ({ key, value })) },
+      templates: { create: templates },
+    },
+  });
+
+  await logAdminAction(session, { action: "event.create", entityType: "event", entityId: event.id, entityLabel: name, eventId: event.id, details: { slug, modules } }, request);
+  return NextResponse.json({ result: "success", event: { id: event.id, slug: event.slug, name: event.name } }, { status: 201 });
+}
