 }
 
 // A logo file uploaded for an event (kept in the database so no file storage has to be set up). id is "<eventId>:<variant>".
@@ -182,6 +184,7 @@ model Registration {
   followUpNotes FollowUpNote[]
   emailEvents   EmailEvent[]
   seat          Seat?
