DATABASE_URL=
DIRECT_URL=
SESSION_SECRET=

# Public address of this dashboard (no trailing slash). Used for the unique "Reserve My Seat" links
# and the QR codes in emails, so it MUST be the real address guests can open.
APP_BASE_URL=https://pertinencegroup.com
# Where the dashboard lives under that address. Leave as is for https://pertinencegroup.com/event.
# Must be set at build time too. Use an empty value to serve from the site root.
NEXT_PUBLIC_BASE_PATH=/event
# Optional. Override the logos and the site icon (defaults are the Pertinence Group files, see src/lib/brand.ts).
# NEXT_PUBLIC_LOGO_URL=            dark logo, for the light theme and emails
# NEXT_PUBLIC_LOGO_WHITE_URL=      white logo, for the dark theme
# NEXT_PUBLIC_ICON_URL=            site icon

# Seed (first admin)
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=

# Email: invitations, reminders and tickets are sent through Gmail / Google Workspace
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME="Investor Hangout"
# Optional. Set to 587 if your network blocks the default port 465.
# GMAIL_SMTP_PORT=587

# Campaign email (Brevo) is only needed for the Campaigns page
BREVO_API_KEY=
BREVO_WEBHOOK_SECRET=
EMAIL_FROM="Investor Hangout <events@example.com>"

# Secret for the scheduled sheet sync. Any long random string.
# Call https://YOUR-DOMAIN/event/api/cron/sheet-sync?key=<this value> every 5 minutes.
CRON_SECRET=

# Optional: more email senders for the sender pool (Email senders page). Gmail and Brevo above are also pool senders.
MAILERSEND_API_KEY=
# An address on a domain you verified in MailerSend
MAILERSEND_FROM="Investor Hangout <events@example.com>"
# Waiting campaign emails are sent when this is called every 15 minutes:
# https://YOUR-DOMAIN/event/api/cron/email-queue?key=<CRON_SECRET>

# WhatsApp (see docs/WHATSAPP_SETUP.md). One number for the whole company.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Numbers typed without a country code get this one.
WHATSAPP_DEFAULT_COUNTRY_CODE=234
