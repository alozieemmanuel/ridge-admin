@@ -0,0 +1,17 @@
+import { NextRequest, NextResponse } from "next/server";
+import { requireEvent } from "@/lib/event";
+import { runDueCampaigns } from "@/lib/scheduledCampaigns";
+
+export const runtime = "nodejs";
+export const maxDuration = 300;
+
+/** Sends this event's campaigns whose time has come. The Campaigns page asks for this while it is open, as a back-up for the timer. */
+export async function POST(request: NextRequest) {
+  const ctx = await requireEvent(request, { module: "campaigns" });
+  if (!ctx.ok) return ctx.response;
+  try {
+    return NextResponse.json({ ok: true, ...(await runDueCampaigns({ eventId: ctx.event.id })) });
+  } catch {
+    return NextResponse.json({ ok: true, ran: 0, results: [] });
+  }
+}
diff --git a/src/app/api/cron/scheduled-campaigns/route.ts b/src/app/api/cron/scheduled-campaigns/route.ts
new file mode 100644
index 0000000..cf0daaa
--- /dev/null
+++ b/src/app/api/cron/scheduled-campaigns/route.ts
@@ -0,0 +1,22 @@
+import { NextRequest, NextResponse } from "next/server";
+import { runDueCampaigns } from "@/lib/scheduledCampaigns";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+export const maxDuration = 300;
+
+/**
+ * Sends every scheduled campaign whose time has come, for every event. Safe to call often: with nothing due it does nothing.
+ * Protected by CRON_SECRET (Authorization: Bearer <secret> or ?key=<secret>). Call it every 5 minutes from an outside timer.
+ */
+async function run(request: NextRequest) {
+  const secret = process.env.CRON_SECRET;
+  if (!secret) return NextResponse.json({ error: "CRON_SECRET is not set." }, { status: 503 });
+  const given = request.headers.get("authorization")?.replace(/^Bearer\s+/i, "") || request.nextUrl.searchParams.get("key") || "";
+  if (given !== secret) return NextResponse.json({ error: "Not allowed." }, { status: 401 });
+  const result = await runDueCampaigns();
+  return NextResponse.json({ ok: true, ...result });
+}
+
+export const GET = run;
+export const POST = run;
